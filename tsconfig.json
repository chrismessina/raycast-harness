{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["bin/**/*.mjs", "src/**/*.mjs", "scripts/**/*.mjs", "scripts/commit-msg", "test/**/*.mjs", "eslint-plugin/**/*.mjs"],
  "exclude": ["node_modules", "test/fixtures"]
}
