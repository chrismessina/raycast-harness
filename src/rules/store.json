{
  "$comment": "Raycast Store facts (core). No owner-specific value lives here; see docs/check-classes.md.",
  "schemaUrl": "https://www.raycast.com/schemas/extension.json",
  "categories": [
    "Applications", "Communication", "Data", "Documentation", "Design Tools", "Developer Tools", "Finance",
    "Fun", "Media", "News", "Productivity", "Security", "System", "Web", "Other"
  ],
  "platforms": ["macOS", "Windows"],
  "preferenceTypes": ["textfield", "password", "checkbox", "dropdown", "appPicker", "file", "directory"],
  "screenshot": { "width": 2000, "height": 1250, "max": 6, "extension": ".png" },
  "icon": { "width": 512, "height": 512 },
  "mergeDatePlaceholder": "{PR_MERGE_DATE}",
  "smallWords": [
    "a", "an", "and", "as", "at", "but", "by", "for", "from", "in", "into", "nor", "of", "on", "or", "per",
    "the", "to", "via", "vs", "with"
  ],
  "publishSkips": [
    ".git", ".github", "node_modules", "raycast-env.d.ts", ".raycast-swift-build", ".swiftpm",
    "compiled_raycast_swift", "compiled_raycast_rust"
  ],
  "greptile": {
    "agentScaffolding": [
      "CLAUDE.md", "AGENTS.md", "GEMINI.md", "PLAN.md", "TODO.md", ".cursor", ".cursorrules", ".claude",
      ".windsurf", "docs/agents", "docs/planning", ".compound-engineering", ".scratch", ".zcodeignore",
      ".coderabbit.yaml", "flake.nix", "flake.lock", ".envrc"
    ],
    "nestedGreptile": [".greptile", "greptile.json"],
    "devMaterial": [
      "LICENSE", "DEVELOPMENT.md", "ARCHITECTURE.md", "VALIDATION.md", "CONTRIBUTING.md", "SECURITY.md",
      "CODE_OF_CONDUCT.md", "docs", "tools"
    ],
    "generatedDirs": ["dist", ".build"],
    "strays": [".DS_Store", "assets/.DS_Store", "metadata/.DS_Store", "media/.DS_Store", "src/.DS_Store"]
  }
}
