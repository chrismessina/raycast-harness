{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clean",
  "title": "Good Extension",
  "description": "Search, open and manage items in Good Extension, and copy their links from the list.",
  "author": "testowner",
  "icon": "icon.png",
  "categories": [
    "Productivity"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Search Items",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "title": "API Key",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.1.0"
  }
}